# Projeto Supabase EXCLUSIVO deste sistema (nao reaproveitar nenhum outro).
# Settings > API Keys dentro do painel do Supabase.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# "Publishable key" (sb_publishable_...): pode aparecer no navegador,
# quem protege os dados e o RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# "Secret key" (sb_secret_...): ignora o RLS. Nunca compartilhar, nunca commitar.
SUPABASE_SECRET_KEY=sb_secret_...

# ID da conta da Kelly (Authentication > Users, coluna UID). So essa conta
# entra no painel. Sem esta variavel, ninguem entra.
KELLY_USER_ID=00000000-0000-0000-0000-000000000000
